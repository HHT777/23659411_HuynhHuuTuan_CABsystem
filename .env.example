# CAB local/demo configuration. Never put real secrets in this file.
SANDBOX_MODE=true
SEED_DEMO_DATA=true
STORAGE_MODE=database
# Generate local RS256 files with: node backend/scripts/generate-jwt-keys.js
# Keep .secrets/jwt-private.pem and .secrets/jwt-public.pem untracked.
JWT_ALLOW_EPHEMERAL=false
JWT_SECRET=deprecated-hs256-not-used
PAYMENT_CALLBACK_SECRET=cab-local-callback-secret
FIELD_ENCRYPTION_KEY=cab-local-field-key-change-me
# Compose uses the mounted secret file, not the fallback key above.
FIELD_ENCRYPTION_KEY_PATH=/run/secrets/field-encryption.key
SEED_PASSWORD=change-me
ADMIN_EMAIL=admin@cab.local
ADMIN_PASSWORD=change-me

POSTGRES_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
# Per-service DB passwords below are reserved design settings; local Compose
# currently connects all six databases as cab using POSTGRES_PASSWORD.
CUSTOMER_DB_PASSWORD=change-me
DRIVER_DB_PASSWORD=change-me
BOOKING_DB_PASSWORD=change-me
TRIP_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
MONGO_URI=mongodb://mongodb:27017/cab_notification_db?replicaSet=rs0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=cab-local
KAFKA_GROUP_ID=cab-local
REDIS_URL=redis://redis:6379

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
INTERNAL_JWT_KEYS=replace-with-local-secret
INTERNAL_ACTIVE_KID=local-v1

FIELD_ENCRYPTION_KEYS=local-key-id:replace-with-32-byte-key
FIELD_ENCRYPTION_ACTIVE_KID=local-v1
BLIND_INDEX_KEY=replace-with-local-secret
PASSWORD_PEPPER=replace-with-local-secret
IDEMPOTENCY_HASH_KEY=replace-with-local-secret
OTP_HASH_KEY=replace-with-local-secret

REGISTRATION_TOKEN_KEY=replace-with-local-secret
REGISTRATION_BINDING_KEY=replace-with-local-secret
# PAYMENT_CALLBACK_SECRET is declared above; keep one value only.

OTP_MOCK_CODE=123456
MAP_PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=mock

# Runtime defaults aligned with SRS §16.1 and microservice_design.md §10.3
GATEWAY_PORT=8000
INTERNAL_SERVICE_TOKEN=replace-with-local-service-token
GRPC_PORT=50051
ACCESS_JWT_TTL=60m
INTERNAL_JWT_TTL=60s
INTERNAL_TIMEOUT_HOP_INNER=1.5s
INTERNAL_TIMEOUT_HOP_OUTER=4s
GATEWAY_TIMEOUT=10s
PASSWORD_MIN_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
REGISTRATION_TOKEN_TTL=15m
OFFER_TTL=90s
DISPATCH_RADIUS=5000
DISPATCH_MAX_OFFERS=5
LOCATION_MAX_AGE=60s
LOCATION_SEND_INTERVAL=5s
OFFER_SCAN_INTERVAL=2s
NEARBY_RADIUS_DEFAULT=1000
PAGE_DEFAULT=1
LIMIT_DEFAULT=20
LIMIT_MAX=50
IDEMPOTENCY_TTL=24h
CALLBACK_CLOCK_SKEW=5m
KAFKA_RETRY_DELAYS=1s,5s,25s
RATE_LOGIN=10/min/IP
RATE_OTP=3/5min/phone+IP
RATE_BOOKING=5/min/userId
RATE_LOCATION=12/min/userId
RATE_PAYMENT=10/min/userId
RATE_GENERAL=100/min/userId
REQUEST_BODY_MAX=1MB
SERVICE_AREA=lat:10.35-11.20,lng:106.35-107.05
COMMENT_REASON_MAX=500
IDEMPOTENCY_KEY_LENGTH=16-64
RESERVATION_TTL=150s
KAFKA_PARTITIONS=3
KAFKA_DLQ_PARTITIONS=1
KAFKA_RETENTION=7d
OUTBOX_POLL_BATCH=100
JWT_INTERNAL_REPLAY_POLICY=disabled-p1

# Local database clients (pgAdmin / Compass)
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
