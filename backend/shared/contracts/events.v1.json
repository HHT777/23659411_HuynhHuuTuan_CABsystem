{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CAB System event envelope v1",
    "type": "object",
    "required": [
        "eventId",
        "eventType",
        "occurredAt",
        "payload"
    ],
    "properties": {
        "eventId": {
            "type": "string"
        },
        "eventType": {
            "type": "string"
        },
        "occurredAt": {
            "type": "string",
            "format": "date-time"
        },
        "payload": {
            "type": "object"
        }
    }
}